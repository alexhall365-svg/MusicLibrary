// ---------------------------------------------------------------------------
// App identity for Xcode/CI builds. Keep in step with MusicLibrary.swiftpm/Package.swift.
// ---------------------------------------------------------------------------

// The name shown under the icon on the Home Screen.
APP_DISPLAY_NAME = Quire

// Must be unique to you. With a free Apple ID, change "example" to something
// personal (e.g. your initials) if Xcode says the ID is unavailable.
APP_BUNDLE_ID = com.example.musiclibrary

// iCloud (CloudKit) container. The TestFlight workflow sets CLOUD_SYNC = YES and
// signs the app with the iCloud entitlements. Leave NO for local and CI builds.
CLOUDKIT_CONTAINER_ID = iCloud.$(APP_BUNDLE_ID)
CLOUD_SYNC = NO

// iCloud IDs that always have Pro (the app's owners), comma-separated. Set by the
// TestFlight workflow from the PRO_OWNERS repository variable.
PRO_OWNERS =

// YES blocks free test purchases in TestFlight. The TestFlight workflow sets it,
// except for the App Store submission build (App Review must be able to buy).
BLOCK_TEST_PURCHASES = NO

MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 1

// Signing team for local Xcode builds. Leave empty and pick your
// "Personal Team" in Xcode's Signing & Capabilities tab, or paste its ID here.
DEVELOPMENT_TEAM =
